{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokens UI For Codex signed schema v3 payload",
  "type": "object",
  "required": [
    "protocolName",
    "schemaVersion",
    "authRequired",
    "auth",
    "capabilities",
    "requestCount",
    "currentTurnRequestCount",
    "sessionTotal",
    "contextUsed",
    "turnTotal",
    "turnInput",
    "turnOutput",
    "currentTurnIndex",
    "turnTotalCount",
    "turns",
    "requestDetails",
    "requestDetailsTruncated",
    "requestDetailTotal",
    "updatedAt"
  ],
  "properties": {
    "protocolName": { "const": "tokens-ui-for-codex" },
    "schemaVersion": { "const": 3 },
    "authRequired": { "const": true },
    "auth": {
      "type": "object",
      "required": ["v", "ts", "nonce", "seq", "mac"],
      "properties": {
        "v": { "const": 1 },
        "ts": { "type": "number", "minimum": 0 },
        "nonce": { "type": "string", "minLength": 16, "maxLength": 64 },
        "seq": { "type": "integer", "minimum": 1 },
        "mac": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "modelContextWindow": { "type": ["number", "null"], "minimum": 0 },
    "requestCount": { "type": "number", "minimum": 0 },
    "currentTurnRequestCount": { "type": "number", "minimum": 0 },
    "sessionTotal": { "type": ["number", "null"], "minimum": 0 },
    "sessionInput": { "type": ["number", "null"], "minimum": 0 },
    "sessionCached": { "type": ["number", "null"], "minimum": 0 },
    "sessionOutput": { "type": ["number", "null"], "minimum": 0 },
    "sessionCacheHitRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "sessionTps": { "type": ["number", "null"], "minimum": 0 },
    "contextUsed": { "type": ["number", "null"], "minimum": 0 },
    "turnTotal": { "type": "number", "minimum": 0 },
    "turnInput": { "type": "number", "minimum": 0 },
    "turnCached": { "type": ["number", "null"], "minimum": 0 },
    "turnOutput": { "type": "number", "minimum": 0 },
    "turnCacheHitRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "lastRequestTps": { "type": ["number", "null"], "minimum": 0 },
    "turnTps": { "type": ["number", "null"], "minimum": 0 },
    "turnWallTps": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "当前轮输出 tokens ÷ 整轮墙钟耗时；包含工具与网络等待"
    },
    "genEstimateTps": { "type": ["number", "null"], "minimum": 0 },
    "compactTps": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "紧凑条稳健估算：最近有效请求生成速度的中位数；样本不足时为 null"
    },
    "compactSpeedSampleCount": { "type": "number", "minimum": 0 },
    "compactSpeedWindow": { "type": "number", "minimum": 0 },
    "compactSpeedConfidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", null]
    },
    "effectiveTps": { "type": ["number", "null"], "minimum": 0 },
    "turnEffectiveTps": { "type": ["number", "null"], "minimum": 0 },
    "effectiveSampleCount": { "type": "number", "minimum": 0 },
    "effectiveWindow": { "type": "number", "minimum": 0 },
    "speedTimingConfidence": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
    "turnsLimit": { "type": "number", "minimum": 0 },
    "requestsLimit": { "type": "number", "minimum": 0 },
    "sessionChanged": { "type": "boolean" },
    "snapshot": { "type": "boolean" },
    "currentTurnIndex": { "type": "number", "minimum": 0 },
    "turnTotalCount": { "type": "number", "minimum": 0 },
    "turnsTruncated": { "type": "boolean" },
    "turns": { "type": "array", "maxItems": 500 },
    "requestDetailsTruncated": { "type": "boolean" },
    "requestDetailTotal": { "type": "number", "minimum": 0 },
    "requestDetails": { "type": "array", "maxItems": 500 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "health": { "type": "object" }
  },
  "additionalProperties": true
}
